{
  // Run via Terminal → Run Task… (or Command Palette → "Tasks: Run Task")
  "version": "2.0.0",
  "tasks": [
    {
      // Backend and frontend in dev mode, both reloading on code changes.
      // Open http://localhost:5173; the frontend forwards /api to the backend.
      "label": "Dev: start app",
      "dependsOn": ["Dev: backend", "Dev: frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      // FastAPI on port 8000, all interfaces; applies migrations on startup.
      // Uses DATABASE_URL from the devcontainer (dev database volume).
      "label": "Dev: backend",
      "type": "shell",
      "command": "uvicorn --factory yap.api.app:create_app_from_env --reload --host 0.0.0.0 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "group": "dev" },
      "problemMatcher": {
        "owner": "uvicorn",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "beginsPattern": "Will watch for changes|Started reloader process",
          "endsPattern": "Application startup complete"
        }
      }
    },
    {
      // Vite dev server on port 5173, all interfaces (see frontend/vite.config.ts)
      "label": "Dev: frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "group": "dev" },
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "beginsPattern": "VITE v",
          "endsPattern": "Local:"
        }
      }
    }
  ]
}
