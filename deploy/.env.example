# Configuration of one environment on the LAN server (spec 5.5, 5.6).
# Copy to .env next to compose.yaml and adjust; deploy.sh sets IMAGE_TAG and
# APP_VERSION_SUFFIX itself.

# prod or staging; deploy.sh refuses to deploy if its argument differs
APP_ENV=prod
# Compose project and database volume, different per environment
COMPOSE_PROJECT_NAME=yap
DB_VOLUME=yap-db-prod
# Port on the server, e.g. 8001 for staging
APP_PORT=8000

# Plain HTTP in the LAN; set to true only behind an HTTPS reverse proxy
COOKIE_SECURE=false

# Backups (NFR-08): made by deploy.sh before every prod deployment, and by the admin
# with: docker compose exec app python -m yap.cli backup /backups/<file>.db
BACKUP_DIR=./backups
# staging only: the prod environment's backup folder; staging starts from its newest backup
#PROD_BACKUP_DIR=../prod/backups

# Registry login, only for a private image: the GitHub user here and a token with
# read:packages in the file ./ghcr-token. The published image needs neither.
#GHCR_USER=

IMAGE_TAG=
# rc.N for a release candidate, empty otherwise; the version itself is in the image
APP_VERSION_SUFFIX=
