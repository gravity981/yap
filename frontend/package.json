    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-table": "9.3.1",
    "@uiw/react-codemirror": "4.25.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.5.2",
