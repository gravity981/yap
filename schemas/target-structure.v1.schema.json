{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "target-structure.v1.schema.json",
  "$defs": {
    "TargetPosition": {
      "additionalProperties": false,
      "properties": {
        "ticker": {
          "maxLength": 32,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Ticker",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "ETF",
            "stock",
            "crypto",
            "cash_buffer"
          ],
          "title": "Type",
          "type": "string"
        },
        "target_pct": {
          "maximum": 100,
          "minimum": 0,
          "title": "Target Pct",
          "type": "number"
        },
        "buy_threshold_pct": {
          "description": "Relative to target, -100 to 0",
          "maximum": 0,
          "minimum": -100,
          "title": "Buy Threshold Pct",
          "type": "number"
        },
        "sell_threshold_pct": {
          "description": "Relative to target, 0 or more",
          "minimum": 0,
          "title": "Sell Threshold Pct",
          "type": "number"
        },
        "exit": {
          "default": false,
          "title": "Exit",
          "type": "boolean"
        },
        "rationale_md": {
          "default": "",
          "title": "Rationale Md",
          "type": "string"
        }
      },
      "required": [
        "ticker",
        "name",
        "type",
        "target_pct",
        "buy_threshold_pct",
        "sell_threshold_pct"
      ],
      "title": "TargetPosition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Target structure of a policy (IMP-02); imported into the selected policy.",
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional reference to the JSON Schema, e.g. for editor validation",
      "title": "$Schema"
    },
    "schema_version": {
      "description": "Schema version the file follows; any 1.x is accepted",
      "examples": [
        "1.3"
      ],
      "pattern": "^1\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "reinvest_sells": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "deprecated": true,
      "description": "Ignored since 1.2: sell proceeds are always reinvested",
      "title": "Reinvest Sells"
    },
    "positions": {
      "items": {
        "$ref": "#/$defs/TargetPosition"
      },
      "minItems": 1,
      "title": "Positions",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "positions"
  ],
  "title": "Target structure import",
  "type": "object"
}
